<Window x:Class="Acetato.Presentation.Views.ToolbarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:b="clr-namespace:Acetato.Presentation.Behaviors"
        xmlns:vm="clr-namespace:Acetato.Presentation.ViewModels"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual"
        FontFamily="{StaticResource Font.Ui}">

    <!-- Tooltips de la barra con nombre y atajo (HU-22); solo en esta ventana. -->
    <Window.Resources>
        <Style TargetType="ToolTip" BasedOn="{StaticResource ToolbarToolTip}" />
    </Window.Resources>

    <!-- Barra glass: único elemento visible (principio #1, CERO distracción). -->
    <!--
      Margen transparente para la sombra (BlurRadius 34, caída 10 hacia abajo). Sin él,
      la ventana mide justo lo que la barra y la sombra solo cabe en las esquinas fuera
      del radio: se ve un rectángulo oscuro detrás de las esquinas redondeadas. Los
      píxeles del margen sin sombra son alfa 0: los clics pasan a lo de abajo.
    -->
    <Border Margin="36,28,36,48"
            Background="{StaticResource Chrome.Glass}"
            CornerRadius="{StaticResource Radius.Toolbar}"
            BorderBrush="{StaticResource Stroke.Outer}"
            BorderThickness="1"
            Padding="6">
        <Border.Effect>
            <DropShadowEffect BlurRadius="34" ShadowDepth="10" Direction="270" Opacity="0.46" Color="#FF000000" />
        </Border.Effect>

        <StackPanel Orientation="Horizontal">

            <!-- Grip de arrastre -->
            <Border Style="{StaticResource GripHandle}"
                    b:WindowDragBehavior.DragHandler="{Binding DragHandler}"
                    ToolTip="{Binding MoveHint}">
                <Path Style="{StaticResource GripGlyph}" />
            </Border>

            <Rectangle Style="{StaticResource ToolDivider}" />

            <!-- Ojo (HU-25): pliega la barra a asa · separador · ojo. El icono muestra
                 el estado y el tooltip nombra la acción. Nunca lleva el acento. -->
            <Button Style="{StaticResource ToolButton}"
                    Command="{Binding ToggleCollapsedCommand}" ToolTip="{Binding CollapseHint}">
                <Path Style="{StaticResource ToolGlyph}" Data="{Binding EyeGlyph}" />
            </Button>

            <!-- Resto de la barra: se oculta al plegar. La ventana ajusta su tamaño al
                 contenido y conserva su borde izquierdo, así que el asa y el ojo no se mueven. -->
            <StackPanel Orientation="Horizontal">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCollapsed}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <!-- Puntero (HU-24): sale del modo dibujo sin ocultar la barra ni los
                     trazos. En modo puntero lleva el acento, como la herramienta activa. -->
                <Button Command="{Binding EnterPointerModeCommand}" ToolTip="{Binding PointerHint}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ToolButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPointerMode}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource Accent.Fill}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Path Data="{StaticResource Icon.Select}">
                        <Path.Style>
                            <Style TargetType="Path" BasedOn="{StaticResource ToolGlyph}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPointerMode}" Value="True">
                                        <Setter Property="Stroke" Value="{StaticResource Accent}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Path.Style>
                    </Path>
                </Button>

                <!-- Herramientas de dibujo (HU-11): la activa se resalta con el acento,
                     salvo en modo puntero (HU-24). -->
                <ItemsControl ItemsSource="{Binding Tools}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ToolItem}">
                            <Button x:Name="ToolBtn" Style="{StaticResource ToolButton}"
                                    IsEnabled="{Binding IsEnabled}" ToolTip="{Binding Hint}"
                                    Command="{Binding DataContext.PickToolCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding Kind}">
                                <Path x:Name="ToolIcon" Style="{StaticResource ToolGlyph}" Data="{Binding Icon}" />
                            </Button>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <Setter TargetName="ToolBtn" Property="Background" Value="{StaticResource Accent.Fill}" />
                                    <Setter TargetName="ToolIcon" Property="Stroke" Value="{StaticResource Accent}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Rectangle Style="{StaticResource ToolDivider}" />

                <!-- Color (funcional): abre el popover de tintas -->
                <Button x:Name="ColorButton" Style="{StaticResource ToolButton}"
                        Command="{Binding ToggleInkPopoverCommand}" ToolTip="{Binding ColorHint}">
                    <Ellipse Width="18" Height="18"
                             Fill="{Binding ActiveInkBrush}"
                             Stroke="{StaticResource Stroke.Highlight}" StrokeThickness="1.5" />
                </Button>

                <!-- Grosor (funcional): abre el popover de grosor -->
                <Button x:Name="ThicknessButton" Style="{StaticResource ToolButton}"
                        Command="{Binding ToggleThicknessPopoverCommand}" ToolTip="{Binding ThicknessHint}">
                    <StackPanel Width="16" VerticalAlignment="Center">
                        <Rectangle Height="1.5" Margin="0,1.5" RadiusX="1" RadiusY="1"
                                   Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        <Rectangle Height="2.5" Margin="0,1.5" RadiusX="1" RadiusY="1"
                                   Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        <Rectangle Height="4" Margin="0,1.5" RadiusX="1" RadiusY="1"
                                   Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </StackPanel>
                </Button>

                <Rectangle Style="{StaticResource ToolDivider}" />

                <!-- Deshacer / Limpiar (funcionales) -->
                <Button Style="{StaticResource ToolButton}" Command="{Binding UndoCommand}" ToolTip="{Binding UndoHint}">
                    <Path Style="{StaticResource ToolGlyph}" Data="{StaticResource Icon.Undo}" />
                </Button>
                <Button Style="{StaticResource ToolButton}" Command="{Binding ClearCommand}" ToolTip="{Binding ClearHint}">
                    <Path Style="{StaticResource ToolGlyph}" Data="{StaticResource Icon.Clear}" />
                </Button>

                <Rectangle Style="{StaticResource ToolDivider}" />

                <!-- Recortar (HU-23) / Ajustes (HU-21) -->
                <Button Style="{StaticResource ToolButton}" Command="{Binding CaptureCommand}" ToolTip="{Binding CaptureHint}">
                    <Path Style="{StaticResource ToolGlyph}" Data="{StaticResource Icon.Capture}" />
                </Button>
                <Button Style="{StaticResource ToolButton}" Command="{Binding OpenSettingsCommand}" ToolTip="{Binding SettingsHint}">
                    <Path Style="{StaticResource ToolGlyph}" Data="{StaticResource Icon.Settings}" />
                </Button>

                <Rectangle Style="{StaticResource ToolDivider}" />

                <!-- Cerrar (funcional): oculta overlay y barra -->
                <Button Style="{StaticResource ToolButton}" Command="{Binding CloseCommand}" ToolTip="{Binding CloseHint}">
                    <Path Style="{StaticResource ToolGlyph}" Data="{StaticResource Icon.Close}" />
                </Button>

            </StackPanel>

            <!-- Popover de tintas -->
            <Popup PlacementTarget="{Binding ElementName=ColorButton}" Placement="Bottom"
                   IsOpen="{Binding IsInkPopoverOpen, Mode=TwoWay}"
                   AllowsTransparency="True" StaysOpen="False" Focusable="False" PopupAnimation="Fade">
                <Border Style="{StaticResource PopoverSurface}">
                    <ItemsControl ItemsSource="{Binding Swatches}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" Columns="7" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:InkSwatchItem}">
                                <Button Margin="4" Cursor="Hand"
                                        Command="{Binding DataContext.PickSwatchCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Ring" Width="30" Height="30" Padding="3"
                                                    CornerRadius="{StaticResource Radius.Swatch}"
                                                    BorderBrush="Transparent" BorderThickness="2">
                                                <Border x:Name="Sample" Background="{Binding Fill}" CornerRadius="5" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <!-- La muestra de degradado es redonda: es un modo, no una tinta (HU-19). -->
                                                <DataTrigger Binding="{Binding IsGradient}" Value="True">
                                                    <Setter TargetName="Ring" Property="CornerRadius" Value="15" />
                                                    <Setter TargetName="Sample" Property="CornerRadius" Value="10" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter TargetName="Ring" Property="BorderBrush" Value="{StaticResource Accent.Ring}" />
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </Popup>

            <!-- Popover de grosor -->
            <Popup PlacementTarget="{Binding ElementName=ThicknessButton}" Placement="Bottom"
                   IsOpen="{Binding IsThicknessPopoverOpen, Mode=TwoWay}"
                   AllowsTransparency="True" StaysOpen="False" Focusable="False" PopupAnimation="Fade">
                <Border Style="{StaticResource PopoverSurface}">
                    <ItemsControl ItemsSource="{Binding Thicknesses}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ThicknessItem}">
                                <Button Width="36" Height="36" Cursor="Hand"
                                        Command="{Binding DataContext.PickThicknessCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding Index}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Cell" Background="Transparent"
                                                    CornerRadius="{StaticResource Radius.Button}">
                                                <Ellipse x:Name="Dot" Width="{Binding Diameter}" Height="{Binding Diameter}"
                                                         HorizontalAlignment="Center" VerticalAlignment="Center"
                                                         Fill="{StaticResource Fg.Resting}" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Cell" Property="Background" Value="{StaticResource Fill.Hover}" />
                                                </Trigger>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter TargetName="Cell" Property="Background" Value="{StaticResource Accent.Fill}" />
                                                    <Setter TargetName="Dot" Property="Fill" Value="{StaticResource Accent}" />
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </Popup>

        </StackPanel>
    </Border>
</Window>
