<Window x:Class="Acetato.Presentation.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="clr-namespace:Acetato.Presentation.Behaviors"
        xmlns:overlay="clr-namespace:Acetato.Presentation.Overlay"
        Title="Acetato"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual">

    <!--
      Capa de dibujo a pantalla completa (HU-03). El InkCanvas captura y renderiza
      los trazos a mano alzada cuando la ventana NO es click-through (modo dibujo,
      HU-02). Fondo transparente para superponerse a cualquier app.
    -->
    <!--
      Dos hojas (HU-35): InkSurface es la hoja de la pantalla (fondo casi transparente) y
      BoardSurface la de la pizarra. Cada una tiene su propio OverlayViewModel (trazos e
      historial) y comparten el estilo «Sheet», que lleva los enlaces y behaviors (ResizeEnabled no es
      una propiedad de dependencia: va directo en cada hoja):
      herramienta, color y grosor (HU-05/06/11), rueda del mouse, cursor de tinta (HU-26),
      degradado (HU-19), texto, mover y redimensionar (SPEC 11, HU-28) y láser (HU-15).
      El DataContext de la ventana es OverlaySheets; cada hoja toma el suyo.
    -->
    <!--
      Fondo de la hoja de la pantalla con alfa MÍNIMO no cero (#01 ≈ 0.4 %, imperceptible).
      En una ventana layered (AllowsTransparency), Windows deja pasar los clics por los
      píxeles con alfa 0; un alfa > 0 hace que el InkCanvas reciba el mouse y pueda
      dibujar. El click-through del modo normal lo gobierna WS_EX_TRANSPARENT.
    -->
    <Window.Resources>
        <Style x:Key="Sheet" TargetType="InkCanvas">
            <Setter Property="EditingMode" Value="{Binding EditingMode}" />
            <Setter Property="Strokes" Value="{Binding Strokes}" />
            <Setter Property="DefaultDrawingAttributes" Value="{Binding ActiveAttributes}" />
            <Setter Property="behaviors:ThicknessWheelBehavior.IncreaseCommand" Value="{Binding IncreaseThicknessCommand}" />
            <Setter Property="behaviors:ThicknessWheelBehavior.DecreaseCommand" Value="{Binding DecreaseThicknessCommand}" />
            <Setter Property="behaviors:ShapeDrawingBehavior.Tool" Value="{Binding ActiveTool}" />
            <Setter Property="behaviors:FreehandStrokeBehavior.Tool" Value="{Binding ActiveTool}" />
            <Setter Property="behaviors:ToolCursorBehavior.Tool" Value="{Binding ActiveTool}" />
            <Setter Property="behaviors:ToolCursorBehavior.Tip" Value="{Binding CursorTip}" />
            <Setter Property="behaviors:InkGradient.Pair" Value="{Binding ActiveGradient}" />
            <Setter Property="behaviors:InkGradient.UsedCommand" Value="{Binding GradientUsedCommand}" />
            <Setter Property="behaviors:TextAnnotationBehavior.Tool" Value="{Binding ActiveTool}" />
            <Setter Property="behaviors:MoveToolBehavior.Tool" Value="{Binding ActiveTool}" />
            <Setter Property="behaviors:MoveToolBehavior.KeyState" Value="{Binding KeyState}" />
            <Setter Property="behaviors:SelectionResizeBehavior.Free" Value="{Binding FreeResize}" />
            <Setter Property="behaviors:LaserPointerBehavior.Tool" Value="{Binding ActiveTool}" />
        </Style>
    </Window.Resources>

    <!--
      Las capas del trazo en vivo (LiveLayer, HU-20) y del láser (LaserLayer, HU-15) quedan
      encima de las dos hojas y sirven a la que se ve; no reciben el mouse. Sus enlaces por
      nombre van directo en cada InkCanvas: ElementName dentro de un estilo no es fiable.
    -->
    <Grid>
        <InkCanvas x:Name="InkSurface"
                   Style="{StaticResource Sheet}"
                   ResizeEnabled="True"
                   DataContext="{Binding Screen}"
                   Background="#01000000"
                   behaviors:FreehandStrokeBehavior.Layer="{Binding ElementName=LiveLayer}"
                   behaviors:LaserPointerBehavior.Layer="{Binding ElementName=LaserLayer}" />
        <InkCanvas x:Name="BoardSurface"
                   Style="{StaticResource Sheet}"
                   ResizeEnabled="True"
                   DataContext="{Binding Board}"
                   Visibility="Collapsed"
                   behaviors:FreehandStrokeBehavior.Layer="{Binding ElementName=LiveLayer}"
                   behaviors:LaserPointerBehavior.Layer="{Binding ElementName=LaserLayer}" />
        <overlay:LiveStrokeLayer x:Name="LiveLayer" IsHitTestVisible="False" />
        <Canvas x:Name="LaserLayer" IsHitTestVisible="False" />
    </Grid>
</Window>
