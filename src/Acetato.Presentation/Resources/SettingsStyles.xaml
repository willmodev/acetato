<!--
  Estilos de la ventana Ajustes (HU-21). Solo tokens vía StaticResource; nada de
  colores hardcodeados. El acento teal marca ÚNICAMENTE la fila que captura.
  Depende de Tokens.xaml, Icons.xaml y ToolbarStyles.xaml (merged antes en App.xaml).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:Acetato.Presentation.ViewModels">

    <!-- Título de la ventana («Ajustes»). -->
    <Style x:Key="SettingsTitle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Fg.Primary}" />
        <Setter Property="FontSize" Value="{StaticResource Text.Tooltip}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Encabezado de bloque («Siempre activos», «Solo al dibujar»). -->
    <Style x:Key="SettingsCaption" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Fg.Resting}" />
        <Setter Property="FontSize" Value="{StaticResource Text.Label}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,14,0,4" />
    </Style>

    <!-- Nombre de la acción en la fila. -->
    <Style x:Key="SettingsRowLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Fg.Primary}" />
        <Setter Property="FontSize" Value="{StaticResource Text.Tooltip}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- Divisor horizontal (hairline). -->
    <Style x:Key="SettingsDivider" TargetType="Rectangle">
        <Setter Property="Height" Value="1" />
        <Setter Property="Fill" Value="{StaticResource Stroke.Divider}" />
    </Style>

    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

    <!-- Combinación como tecla pulsable: monoespaciada (text-kbd), sobre un fondo
         apenas elevado. Al capturar, el acento teal (único uso en Ajustes). -->
    <Style x:Key="KbdButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Fg.Resting}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Cap" MinWidth="132" Padding="8,4"
                            Background="{StaticResource Chrome.Solid2}"
                            BorderBrush="{StaticResource Stroke.Outer}" BorderThickness="1"
                            CornerRadius="{StaticResource Radius.Swatch}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          TextElement.FontFamily="{StaticResource Font.Mono}"
                                          TextElement.FontSize="{StaticResource Text.Kbd}"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Cap" Property="BorderBrush" Value="{StaticResource Stroke.Highlight}" />
                            <Setter Property="Foreground" Value="{StaticResource Fg.Primary}" />
                        </Trigger>
                        <DataTrigger Binding="{Binding IsCapturing}" Value="True">
                            <Setter TargetName="Cap" Property="Background" Value="{StaticResource Accent.Fill}" />
                            <Setter TargetName="Cap" Property="BorderBrush" Value="{StaticResource Accent.Ring}" />
                            <Setter Property="Foreground" Value="{StaticResource Accent}" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Botón de texto discreto (Reemplazar, Cancelar). -->
    <Style x:Key="SettingsTextButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Fg.Primary}" />
        <Setter Property="FontSize" Value="{StaticResource Text.Label}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Margin" Value="6,0,0,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Padding="8,3" Background="Transparent"
                            CornerRadius="{StaticResource Radius.Swatch}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource Fill.Hover}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Mensaje en línea bajo la fila (error o conflicto). -->
    <Style x:Key="SettingsMessage" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Status.Danger}" />
        <Setter Property="FontSize" Value="{StaticResource Text.Label}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Fila de atajo: nombre a la izquierda, combinación a la derecha y, debajo,
         el mensaje en línea con Reemplazar/Cancelar si hay conflicto. -->
    <DataTemplate x:Key="HotkeyRowTemplate" DataType="{x:Type vm:HotkeyRowViewModel}">
        <Grid MinHeight="30">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="30" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Style="{StaticResource SettingsRowLabel}" Text="{Binding Label}" />
            <Button Grid.Column="1" Style="{StaticResource KbdButton}"
                    Content="{Binding ChordText}" Command="{Binding StartCaptureCommand}" />
            <DockPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,0,0,6" LastChildFill="True"
                       Visibility="{Binding HasMessage, Converter={StaticResource BoolToVisibility}}">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                            Visibility="{Binding CanReplace, Converter={StaticResource BoolToVisibility}}">
                    <Button Style="{StaticResource SettingsTextButton}" Content="Reemplazar"
                            Command="{Binding ReplaceCommand}" />
                    <Button Style="{StaticResource SettingsTextButton}" Content="Cancelar"
                            Command="{Binding CancelCaptureCommand}" />
                </StackPanel>
                <TextBlock Style="{StaticResource SettingsMessage}" Text="{Binding Message}" />
            </DockPanel>
        </Grid>
    </DataTemplate>

</ResourceDictionary>
