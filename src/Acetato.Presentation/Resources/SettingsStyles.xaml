<!--
  Estilos de la ventana Ajustes (HU-21). Solo tokens vía StaticResource; nada de
  colores hardcodeados. El acento teal marca ÚNICAMENTE la fila que captura.
  Depende de Tokens.xaml, Icons.xaml y ToolbarStyles.xaml (merged antes en App.xaml).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:Acetato.Presentation.ViewModels">

    <!-- Título de la ventana («Ajustes»). -->
    <Style x:Key="SettingsTitle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Fg.Primary}" />
        <Setter Property="FontSize" Value="{StaticResource Text.Tooltip}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Encabezado de bloque («Siempre activos», «Solo al dibujar»). -->
    <Style x:Key="SettingsCaption" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Fg.Resting}" />
        <Setter Property="FontSize" Value="{StaticResource Text.Label}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,14,0,4" />
    </Style>

    <!-- Nombre de la acción en la fila. -->
    <Style x:Key="SettingsRowLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Fg.Primary}" />
        <Setter Property="FontSize" Value="{StaticResource Text.Tooltip}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- Divisor horizontal (hairline). -->
    <Style x:Key="SettingsDivider" TargetType="Rectangle">
        <Setter Property="Height" Value="1" />
        <Setter Property="Fill" Value="{StaticResource Stroke.Divider}" />
    </Style>

    <!-- Tecla: monoespaciada (text-kbd), sobre un fondo apenas elevado. -->
    <Style x:Key="KbdCap" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Chrome.Solid2}" />
        <Setter Property="BorderBrush" Value="{StaticResource Stroke.Outer}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Swatch}" />
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="MinWidth" Value="96" />
    </Style>

    <Style x:Key="KbdText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
        <Setter Property="FontSize" Value="{StaticResource Text.Kbd}" />
        <Setter Property="Foreground" Value="{StaticResource Fg.Resting}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <!-- Fila de atajo: nombre a la izquierda, combinación a la derecha. -->
    <DataTemplate x:Key="HotkeyRowTemplate" DataType="{x:Type vm:HotkeyRowViewModel}">
        <Grid MinHeight="30">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource SettingsRowLabel}" Text="{Binding Label}" />
            <Border Grid.Column="1" Style="{StaticResource KbdCap}" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource KbdText}" Text="{Binding ChordText}" />
            </Border>
        </Grid>
    </DataTemplate>

</ResourceDictionary>
