<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net9.0-windows10: interop Win32 (P/Invoke) + API de toasts de WinRT (HU-12) -->
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <RootNamespace>Acetato.Infrastructure</RootNamespace>
    <!-- Requerido por el código generado de [LibraryImport] (P/Invoke source-gen) -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Enumeración fiable de monitores vía System.Windows.Forms.Screen (HU-09) -->
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Acetato.Application\Acetato.Application.csproj" />
    <ProjectReference Include="..\Acetato.Domain\Acetato.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Toast clickable de atajos no disponibles (HU-21): registra la identidad
         de la app sin acceso directo en Inicio; al activarlo abre Ajustes. -->
    <PackageReference Include="CommunityToolkit.WinUI.Notifications" />
  </ItemGroup>

</Project>
